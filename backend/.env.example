NODE_ENV=development
PORT=5000

# Comma-separated frontend origins allowed by backend CORS.
FRONTEND_URL=http://localhost:5173

# AI providers. Add more numbered keys as needed.
GEMINI_KEY_1=
GEMINI_KEY_2=
GROQ_KEY_1=

# Firebase Admin SDK.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_DATABASE_URL=

# Local development option. Keep the JSON file out of git.
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# Production option. Use this in hosting env vars instead of deploying a JSON file.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
